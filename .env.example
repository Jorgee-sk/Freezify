# Copy to .env (never committed) and fill in. Used by docker-compose.yml.

# Password of the PostgreSQL user "freezify".
FREEZIFY_DB_PASSWORD=

# Signs the access tokens (HS256). At least 32 bytes; generate one with:
#   openssl rand -base64 48
FREEZIFY_JWT_SECRET=

# Comma-separated browser origins allowed to call the API directly.
# Not needed for the bundled web app, which reaches the API through the same origin.
FREEZIFY_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional, to send push notifications. The Firebase service account key is a secret: keep it in a folder
# outside the repository. That folder is mounted read-only at /run/secrets/freezify in the backend container.
# FREEZIFY_SECRETS_DIR=/home/me/.freezify
# FREEZIFY_FCM_CREDENTIALS_FILE_IN_CONTAINER=/run/secrets/freezify/firebase-service-account.json

# Optional. "true" publishes the description of the API (/v3/api-docs, /swagger-ui.html). Off by default.
# FREEZIFY_API_DOCS=false

# The web's session cookie is only sent over HTTPS. Set to false only to try Docker over plain http.
# FREEZIFY_REFRESH_COOKIE_SECURE=true

# Optional. A language model that reads receipts better than the rules alone (see docs/HOW_TO_USE.md 2.5).
# Without it receipts are read by rules. The key is a secret: keep it in .env, which git ignores.
# FREEZIFY_AI_PROVIDER=openai-compatible
# FREEZIFY_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# FREEZIFY_AI_API_KEY=
# FREEZIFY_AI_MODEL=gemini-2.5-flash
# FREEZIFY_AI_DAILY_CALLS_PER_USER=30
